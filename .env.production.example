# ── Produktion (z. B. Vercel) – alle Werte als Environment Variables setzen ──

# Pflicht
DATABASE_URL="postgresql://…"        # z. B. Neon/Supabase/Railway Postgres (pooled connection string)
AUTH_SECRET=""                        # openssl rand -hex 32  (min. 32 Zeichen)

# Optional – ohne diese Keys laufen ehrliche Demo-Adapter (klar gekennzeichnet)
DEMO_MODE="false"                     # NIEMALS "true" in Produktion (zeigt Demo-Login-Buttons)
LIVE_PROVIDER="demo"                  # livekit | daily (+ Zugangsdaten)
AI_PROVIDER="demo"                    # openai (+ OPENAI_API_KEY, AI_MODEL)
PAYMENTS_PROVIDER="demo"              # stripe (+ STRIPE_SECRET_KEY)
