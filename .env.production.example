# ── Produktion (z. B. Vercel) – alle Werte als Environment Variables setzen ──

# Pflicht
DATABASE_URL="postgresql://…"        # z. B. Neon/Supabase/Railway Postgres (pooled connection string)
AUTH_SECRET=""                        # openssl rand -hex 32  (min. 32 Zeichen)

# Optional – ohne diese Keys laufen ehrliche Demo-Adapter (klar gekennzeichnet)
DEMO_MODE="false"                     # NIEMALS "true" in Produktion (zeigt Demo-Login-Buttons)
LIVE_PROVIDER="demo"                  # livekit | daily (+ Zugangsdaten)
AI_PROVIDER="demo"                    # openai (+ OPENAI_API_KEY, AI_MODEL)
PAYMENTS_PROVIDER="demo"              # stripe (+ STRIPE_SECRET_KEY)

# ── Aussprache-Feature (Pronunciation Learning) ──
# Bisher NICHT in Vercel gesetzt (nur lokal in .env.local) — ohne diese vier
# Werte gibt /api/pronunciation in Produktion einen 500er zurück bzw. läuft
# ohne MASAAR/IQRA-Zusatzdaten.
AZURE_SPEECH_KEY=""                   # Azure Speech resource key
AZURE_SPEECH_REGION=""                # z. B. "westeurope"
MASAAR_URL=""                         # z. B. https://api.example.com/masaar (kein /predict-Suffix)
IQRA_URL=""                           # z. B. https://api.example.com/iqra (kein /predict-Suffix)
INTERNAL_API_KEY=""                   # exakt derselbe Wert wie INTERNAL_API_KEY auf dem VPS
