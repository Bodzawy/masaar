# ---- Required ----
# PostgreSQL-Verbindungsstring (lokal oder Neon/Supabase/Railway)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/deutschpath"
# Signiert Session-JWTs (min. 32 Zeichen). Generieren mit: openssl rand -hex 32
AUTH_SECRET=""

# ---- Optional feature flags ----
# "true" zeigt den Demo-Konto-Auswähler auf /signin (NUR Entwicklung – nie in Produktion setzen!)
DEMO_MODE="false"

# ---- Integration boundaries (all optional; absent = honest local demo adapters) ----
# Live video provider: "demo" (default) | "livekit"
LIVE_PROVIDER="demo"
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# AI assistant provider: "demo" (default) | "openai"
AI_PROVIDER="demo"
OPENAI_API_KEY=""
AI_MODEL="gpt-4o-mini"

# Payments provider: "demo" (default) | "stripe"
PAYMENTS_PROVIDER="demo"
STRIPE_SECRET_KEY=""

# Lesson recording storage/consent retention (days); recordings are NOT stored in this MVP
RECORDING_RETENTION_DAYS="30"
